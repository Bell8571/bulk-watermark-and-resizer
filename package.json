{
  "name": "prophoto-watermarker-resizer",
  "version": "2.0.0",
  "productName": "ProPhoto Watermarker & Resizer",
  "description": "Bulk watermark and resize for photographers (client-side processing)",
  "author": "BellCorporateLabs",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist:win": "npm run build:icon && vite build && electron-builder --win",
    "build:icon": "node scripts/build-icon.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.bellcorporatelabs.prophoto-watermarker",
    "productName": "ProPhoto Watermarker & Resizer",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "assets/icons/icon.ico",
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ProPhoto-Watermarker-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ProPhoto-Watermarker-${version}.exe"
    }
  }
}
